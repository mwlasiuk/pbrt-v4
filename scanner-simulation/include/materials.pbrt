MakeNamedMaterial "mat/diffuse-black"
    "string type" "diffuse"
    "rgb reflectance" [ 0.025 0.025 0.025 ]

MakeNamedMaterial "mat/diffuse-gray"
    "string type" "diffuse"
    "rgb reflectance" [ 0.75 0.75 0.75 ]

MakeNamedMaterial "mat/diffuse-red"
    "string type" "diffuse"
    "rgb reflectance" [ 0.85 0.125 0.125 ]