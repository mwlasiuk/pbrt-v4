Include "scanner-simulation/include/cameras/film-4056-3040.pbrt"
    "string filename" [ "out/Sphere/11.png" ]

Include "scanner-simulation/include/path_tracing_settings.pbrt"
Include "scanner-simulation/include/camera.pbrt"

WorldBegin

Include "scanner-simulation/include/materials.pbrt"
Include "scanner-simulation/include/sphere.pbrt"

AttributeBegin
    Include "scanner-simulation/include/projector_pose.pbrt"
    Include "scanner-simulation/include/projector_parameters.pbrt" 
    "string filename" [ "scanner-simulation/projector_images/fhd/gray_patterns/5.png" ]
    "string filter" ["nearest"]
AttributeEnd

AttributeBegin
    Translate 0.0 0.0 0.0
    Rotate 0 1 0 0
    Rotate 0 0 1 0
    Rotate 0 0 0 1
    Scale 0.25 0.25 0.25
    ObjectInstance "obj/sphere"
AttributeEnd
