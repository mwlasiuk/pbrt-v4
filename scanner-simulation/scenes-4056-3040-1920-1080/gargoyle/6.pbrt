Include "scanner-simulation/include/cameras/film-4056-3040.pbrt"
    "string filename" [ "out/Gargoyle/6.png" ]

Include "scanner-simulation/include/path_tracing_settings.pbrt"
Include "scanner-simulation/include/camera.pbrt"

WorldBegin

AttributeBegin
    Include "scanner-simulation/include/projector_pose.pbrt"
    Include "scanner-simulation/include/projector_parameters.pbrt" 
    "string filename" [ "scanner-simulation/projector_images/fhd/gray_patterns/0.png" ]
    "string filter" ["nearest"]
AttributeEnd


AttributeBegin
    Translate 0.0 0 0.1
    Rotate 0 1 0 0
    Rotate 0 0 1 0
    Rotate 0 0 0 1
    Scale 1 1 1
    
    Texture "albedomap" "spectrum" "imagemap"
        "string filename" [ "pbrt-v4-scenes/gargoyle/gargoyle.jpg" ]
    Shape "plymesh"
        "string filename" [ "pbrt-v4-scenes/gargoyle/gargoyle.ply.gz" ]
AttributeEnd
